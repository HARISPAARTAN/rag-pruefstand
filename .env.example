# Copy to .env (git-ignored) or set these in your user environment. Never commit real values.
# Needed only for a live run (PRUEFSTAND_LLM_MODE=record); CI and the default profile need no key.
ANTHROPIC_API_KEY=
# Ollama for the local generator (default http://localhost:11434)
OLLAMA_HOST=http://localhost:11434
# record | replay | live (default: replay from pruefstand.toml)
PRUEFSTAND_LLM_MODE=replay
# Set to 1 to forbid Hugging Face downloads (CI sets it)
HF_HUB_OFFLINE=0
